#!/usr/bin/env bash
# Glide Codespace - command line for the streamed Minecraft session.
#
#   glide up                     start display, stream and Minecraft (background)
#   glide down                   stop everything
#   glide restart                restart everything
#   glide restart-game           relaunch Minecraft only
#   glide restart-stream         restart Selkies only (keeps the game running)
#   glide install <ver> <loader> [heap]   switch installation and restart the game
#   glide status                 state, stream URL and process summary
#   glide url                    the private 6080 URL
#   glide logs [name]            tail boot|minecraft|game|selkies|nginx|setup
#   glide profile low|medium|high
#   glide resize 1280x720        restart the session at a resolution
#   glide dashboard on|off       show/hide the Selkies sidebar
#   glide link                   link a passphrase profile (survives account switches)
#   glide unlink                 remove the portable profile key
#   glide sync                   save the profile (portable store + fork)
#   glide save                   copy worlds/settings back into Client/
#   glide env                    edit ~/.glide/session.env
#   glide setup [--force]        (re)provision the codespace
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"

glide_ensure_dirs
glide_load_env

boot_detached() {
  local mode="${1:-all}"
  GLIDE_BOOT_ACTIVE=1 setsid nohup bash "$HERE/boot.sh" "--$mode" \
    >/dev/null 2>&1 </dev/null &
}

stop_component() {
  local name="$1" pid_file="$GLIDE_RUN_DIR/$1.pid" pid
  [ -f "$pid_file" ] || return 0
  pid="$(cat "$pid_file" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

state_var() {
  [ -f "$GLIDE_STATE_FILE" ] || return 0
  awk -F= -v key="$1" '$1==key { sub(/^[^=]*=/, ""); print; exit }' "$GLIDE_STATE_FILE"
}

cmd_status() {
  local stage detail started uptime service line
  stage="$(state_var STAGE)"
  detail="$(state_var DETAIL)"
  started="$(state_var SESSION_STARTED_AT)"
  [ -n "$stage" ] || stage="idle"
  [ -n "$detail" ] || detail="nothing running"
  uptime=""
  if [ -n "$started" ] && [ "$started" != "0" ]; then
    uptime="$(format_seconds "$(( $(date +%s) - started ))")"
  fi

  printf 'Glide Codespace\n'
  printf '  url        %s\n' "$(glide_public_url)"
  printf '  minecraft  %s / %s / %s\n' "$GLIDE_MINECRAFT_VERSION" "$GLIDE_MINECRAFT_LOADER" "$GLIDE_MINECRAFT_XMX"
  printf '  stage      %s - %s\n' "$stage" "$detail"
  if glide_port_open "$GLIDE_PROXY_PORT" "/healthz"; then
    printf '  stream     up on private :%s -> :%s\n' "$GLIDE_PROXY_PORT" "$GLIDE_SELKIES_PORT"
  else
    printf '  stream     down\n'
  fi
  [ -n "$uptime" ] && printf '  uptime     %s\n' "$uptime"
  printf '  processes '
  for service in xvfb selkies minecraft; do
    if glide_pid_alive "$GLIDE_RUN_DIR/$service.pid"; then
      printf '%s=%s ' "$service" "up"
    else
      printf '%s=%s ' "$service" "down"
    fi
  done
  printf '\n'
  if glide_profile_linked; then
    printf '  profile    portable store + fork\n'
  else
    printf '  profile    fork only (run: glide link to sync across accounts)\n'
  fi
  printf '  logs       %s\n' "$GLIDE_LOG_DIR"
  printf '  port       keep 6080 private; open it from github.dev or a signed-in tab\n'
}

format_seconds() {
  local total="${1:-0}" h m s
  h=$((total / 3600)); m=$(((total % 3600) / 60)); s=$((total % 60))
  if [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
  elif [ "$m" -gt 0 ]; then printf '%dm %02ds' "$m" "$s"
  else printf '%ds' "$s"; fi
}

cmd_url() {
  printf '%s\n' "$(glide_public_url)"
}

cmd_install() {
  local version="${1:-}" loader="${2:-}" heap="${3:-$GLIDE_MINECRAFT_XMX}"
  if [ -z "$version" ] || [ -z "$loader" ]; then
    printf 'current: %s / %s / %s\n' "$GLIDE_MINECRAFT_VERSION" "$GLIDE_MINECRAFT_LOADER" "$GLIDE_MINECRAFT_XMX"
    printf 'usage: glide install <minecraft-version> <loader> [heap]\n'
    printf 'loaders: vanilla fabric legacy-fabric forge legacy-forge quilt neoforge\n'
    return 2
  fi
  printf '%s' "$version" | grep -Eq '^[0-9]{1,2}\.[0-9]{1,2}(\.[0-9]{1,2})?$' || {
    printf 'invalid Minecraft version: %s\n' "$version" >&2
    return 2
  }
  case "$loader" in
    vanilla | fabric | legacy-fabric | forge | legacy-forge | quilt | neoforge) ;;
    *)
      printf 'invalid loader: %s\n' "$loader" >&2
      return 2
      ;;
  esac
  printf '%s' "$heap" | grep -Eq '^[1-9][0-9]?G$' || {
    printf 'invalid heap: %s (use 2G..8G)\n' "$heap" >&2
    return 2
  }
  glide_env_set GLIDE_MINECRAFT_VERSION "$version"
  glide_env_set GLIDE_MINECRAFT_LOADER "$loader"
  glide_env_set GLIDE_MINECRAFT_XMX "$heap"
  glide_profile_sync "installation $version $loader"
  glide_state_stage restarting-game "Switching to $version ($loader)"
  glide_log "installation set to $version / $loader / $heap"
  boot_detached game
}

cmd_profile() {
  local preset="${1:-medium}"
  case "$preset" in
    low) glide_env_set GLIDE_FPS 30; glide_env_set GLIDE_BITRATE 2500 ;;
    medium) glide_env_set GLIDE_FPS 60; glide_env_set GLIDE_BITRATE 6000 ;;
    high) glide_env_set GLIDE_FPS 60; glide_env_set GLIDE_BITRATE 12000 ;;
    *)
      printf 'usage: glide profile low|medium|high\n' >&2
      return 2
      ;;
  esac
  glide_profile_sync "stream profile $preset"
  glide_log "stream profile set to $preset - restarting the stream"
  cmd_restart_stream
}

cmd_restart_stream() {
  glide_state_stage restarting-stream "Restarting the stream"
  stop_component selkies
  boot_detached stream
  glide_log "stream restarting (the game keeps running)"
}

cmd_restart_game() {
  glide_state_stage restarting-game "Restarting Minecraft"
  boot_detached game
  glide_log "Minecraft restarting"
}

cmd_restart() {
  glide_state_stage restarting-stream "Restarting the session"
  bash "$HERE/stop.sh"
  boot_detached all
  glide_log "session restarting"
}

cmd_resize() {
  local value="${1:-}"
  if ! printf '%s' "$value" | grep -Eq '^[0-9]{3,4}x[0-9]{3,4}$'; then
    printf 'usage: glide resize 1280x720\n' >&2
    return 2
  fi
  glide_env_set GLIDE_RESOLUTION "$value"
  glide_profile_sync "resolution $value"
  glide_log "resolution set to $value - restarting the session"
  cmd_restart
}

cmd_dashboard() {
  local mode="${1:-on}"
  case "$mode" in
    on) glide_env_set GLIDE_DASHBOARD true ;;
    off) glide_env_set GLIDE_DASHBOARD false ;;
    *)
      printf 'usage: glide dashboard on|off\n' >&2
      return 2
      ;;
  esac
  glide_profile_sync "dashboard $mode"
  glide_log "stream dashboard: $mode"
  cmd_restart_stream
}

cmd_save() {
  local version="$GLIDE_MINECRAFT_VERSION" loader="$GLIDE_MINECRAFT_LOADER"
  local dest="$GLIDE_REPO_CLIENT/$version" saved=0 item
  mkdir -p "$dest/worlds" "$dest/resourcepacks" "$dest/settings/$loader"
  if [ -d "$GLIDE_MC/saves" ]; then
    cp -a "$GLIDE_MC/saves/." "$dest/worlds/" 2>/dev/null && saved=1
  fi
  if [ -d "$GLIDE_MC/resourcepacks" ]; then
    cp -a "$GLIDE_MC/resourcepacks/." "$dest/resourcepacks/" 2>/dev/null && saved=1
  fi
  for item in config shaderpacks options.txt optionsof.txt servers.dat; do
    if [ -e "$GLIDE_MC/$item" ]; then
      cp -a "$GLIDE_MC/$item" "$dest/settings/$loader/" 2>/dev/null && saved=1
    fi
  done
  glide_game_push
  if [ "$saved" = "1" ]; then
    glide_log "worlds and settings copied to Client/$version (commit them to keep them)"
  else
    glide_log "nothing to save yet"
  fi
}

cmd_logs() {
  local name="${1:-boot}" limit="${2:-200}" file
  case "$name" in
    boot) file="$GLIDE_LOG_DIR/boot.log" ;;
    minecraft | mc | launcher) file="$GLIDE_LOG_DIR/minecraft.log" ;;
    game | java) file="/tmp/glide-minecraft.log" ;;
    selkies | stream) file="$GLIDE_LOG_DIR/selkies.log" ;;
    nginx) file="$GLIDE_NGINX_DIR/logs/error.log" ;;
    setup) file="$GLIDE_LOG_DIR/setup.log" ;;
    actions) file="$GLIDE_LOG_DIR/actions.log" ;;
    *)
      printf 'usage: glide logs boot|minecraft|game|selkies|nginx|setup|actions [-f]\n' >&2
      return 2
      ;;
  esac
  [ -f "$file" ] || {
    printf 'no log at %s\n' "$file" >&2
    return 1
  }
  tail -n "$limit" -F "$file"
}

cmd_sync() {
  glide_profile_sync "manual save"
  glide_game_push
  glide_log "profile and game settings synced"
}

cmd_link() {
  glide_profile_link
}

cmd_unlink() {
  glide_profile_unlink
}

cmd_env() {
  local editor="${EDITOR:-}"
  if [ -z "$editor" ]; then
    if glide_have nano; then editor=nano
    elif glide_have vim; then editor=vim
    else editor=cat
    fi
  fi
  "$editor" "$GLIDE_SESSION_ENV"
  glide_profile_sync "session.env edit"
  glide_log "saved $GLIDE_SESSION_ENV (run: glide restart-game)"
}

usage() {
  cat <<'TXT'
glide - the Glide codespace session CLI

  glide up                     start display, stream and Minecraft (background)
  glide up --wait              same, but keep the boot log in the foreground
  glide down                   stop everything
  glide restart                restart everything
  glide restart-game           relaunch Minecraft only
  glide restart-stream         restart Selkies only, keep the game running
  glide install <ver> <loader> [heap]
  glide status                 state, URL, process summary
  glide url                    the private 6080 URL
  glide logs [name]            boot|minecraft|game|selkies|nginx|setup|actions
  glide profile low|medium|high
  glide resize 1280x720        restart the session at a resolution
  glide dashboard on|off       show/hide the Selkies sidebar
  glide link                   link a passphrase profile (survives account switches)
  glide unlink                 remove the portable profile key
  glide sync                   save the profile (portable store + fork)
  glide save                   copy worlds/settings back into Client/
  glide env                    edit ~/.glide/session.env
  glide setup [--force]        (re)provision the codespace
TXT
}

case "${1:-}" in
  up)
    shift
    if [ "${1:-}" = "--wait" ] || [ "${1:-}" = "-f" ]; then
      bash "$HERE/boot.sh" --all
    else
      bash "$HERE/boot.sh" --detach
    fi
    ;;
  down | stop) shift; bash "$HERE/stop.sh" "${1:-}" ;;
  restart) shift; cmd_restart ;;
  restart-game) cmd_restart_game ;;
  restart-stream) cmd_restart_stream ;;
  install) shift; cmd_install "$@" ;;
  status) cmd_status ;;
  url) cmd_url ;;
  logs) shift; cmd_logs "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  resize) shift; cmd_resize "$@" ;;
  dashboard) shift; cmd_dashboard "$@" ;;
  sync) cmd_sync ;;
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  save) cmd_save ;;
  env) cmd_env ;;
  setup) shift; bash "$HERE/setup.sh" "$@" ;;
  version | --version) printf 'glide %s (selkies %s)\n' "3.3" "$(cat "$GLIDE_HOME/selkies.version" 2>/dev/null || echo unknown)" ;;
  help | -h | --help | "") usage ;;
  *)
    printf 'unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
