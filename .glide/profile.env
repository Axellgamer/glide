# Glide profile - non-secret settings, safe to commit.
# The codespace applies this file before ~/.glide/session.env, so it survives
# replacing or deleting the codespace. No passwords or tokens belong here.

GLIDE_MINECRAFT_VERSION=1.21.5
GLIDE_MINECRAFT_LOADER=fabric
GLIDE_MINECRAFT_XMX=4G
GLIDE_RESOLUTION=1280x720
GLIDE_FPS=60
GLIDE_BITRATE=6000
GLIDE_ENCODER=h264enc
GLIDE_DASHBOARD=true
GLIDE_AUDIO=true
GLIDE_AUTH_MODE=offline
GLIDE_OFFLINE_USERNAME=GlidePlayer
GLIDE_MAX_RESTARTS=3
GLIDE_RENDERER=auto
