{
  "name": "Glide — streamed Minecraft",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    6080,
    6081
  ],
  "portsAttributes": {
    "6080": {
      "label": "Glide stream (public)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "6081": {
      "label": "Glide Runner terminal (authenticated)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "onCreateCommand": "bash codespace/setup.sh",
  "postStartCommand": {
    "glide": "bash codespace/boot.sh --detach",
    "glideRunner": "bash .glide/runner-start.sh"
  },
  "postAttachCommand": "bash codespace/menu.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.scrollback": 10000
      }
    }
  }
}
