{
  "name": "Glide — streamed Minecraft",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Glide stream (private)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "onCreateCommand": "bash codespace/setup.sh",
  "postStartCommand": "bash codespace/boot.sh --detach",
  "postAttachCommand": "bash codespace/menu.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.scrollback": 10000
      }
    }
  }
}
